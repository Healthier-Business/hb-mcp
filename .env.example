# Copy to .env.local and `set -a; . ./.env.local; set +a` before starting your client. Never commit a real key.
HB_API_KEY=hbk_test_replace_me
HB_BASE_URL=https://YOUR-SANDBOX-URL
HB_READ_ONLY=true
HB_ALLOW_LIVE_WRITES=false
HB_TOOL_MODE=compact
HB_LOG_LEVEL=warn
# Folders hb_verify_certificate may read certificate files from (comma list of absolute paths). Unset: the working directory only.
# HB_UPLOAD_DIRS=/Users/you/certificates
